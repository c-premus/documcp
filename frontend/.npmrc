# npm 12 (bundled with Node 26, see .nvmrc) defaults to allow-remote=none and
# counts the registry tarball fetch it needs to read a package's
# bundleDependencies as a "remote" fetch. Updating any package that bundles its
# deps (e.g. @tailwindcss/oxide-wasm32-wasi) then fails with EALLOWREMOTE, which
# breaks Renovate's lockfile update and the dist rebuild after it (PR #812).
# "root" is not enough because the package is transitive. Every resolved
# tarball is still pinned by its integrity hash in package-lock.json.
allow-remote=all
