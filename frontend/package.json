{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "vue-tsc -b && eslint .",
    "lint:fix": "eslint . --fix && prettier --write src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@headlessui/vue": "1.7.23",
    "@heroicons/vue": "2.2.0",
    "@sentry/vue": "11.12.0",
    "@tanstack/vue-table": "9.3.1",
    "date-fns": "4.4.0",
    "dompurify": "3.4.17",
    "marked": "18.2.0",
    "mermaid": "^12.2.0",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.0",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "@vue/server-renderer": "$vue"
  }
}
