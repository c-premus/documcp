{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "vue-tsc -b && eslint .",
    "lint:fix": "eslint . --fix && prettier --write src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@headlessui/vue": "1.7.23",
    "@heroicons/vue": "2.2.0",
    "@sentry/vue": "10.75.0",
    "@tanstack/vue-table": "9.2.4",
    "date-fns": "4.4.0",
    "dompurify": "3.4.15",
    "marked": "18.0.13",
    "mermaid": "^12.0.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "vue-sonner": "2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.8",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "dompurify": "3.4.15",
    "brace-expansion": "5.0.12",
    "@vue/server-renderer": "$vue",
    "lodash-es": "4.18.1"
  }
}
